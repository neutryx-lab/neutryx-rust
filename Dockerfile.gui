# --- Stage 1: Build ---
FROM rust:1.84-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN cargo build --release -p demo_gui --bin demo-web

# --- Stage 2: Runtime ---
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/demo-web ./demo-web
# Copy static files to the path expected by the code
COPY --from=builder /app/demo/gui/static ./demo/gui/static
# Copy data files for nest_service("/data/input", ServeDir::new("demo/data/input"))
COPY --from=builder /app/demo/data/input ./demo/data/input

# Verify critical files exist (build will fail if missing)
# This helps catch file path issues before deployment
RUN echo "=== Verifying static files ===" && \
    ls -la ./demo/gui/static/ && \
    test -f ./demo/gui/static/index.html || (echo "ERROR: index.html missing" && exit 1) && \
    test -f ./demo/gui/static/app.js || (echo "ERROR: app.js missing" && exit 1) && \
    test -f ./demo/gui/static/config.js || (echo "ERROR: config.js missing" && exit 1) && \
    test -f ./demo/gui/static/style.css || (echo "ERROR: style.css missing" && exit 1) && \
    echo "=== Verifying js directory ===" && \
    test -d ./demo/gui/static/js || (echo "ERROR: js directory missing" && exit 1) && \
    ls -la ./demo/gui/static/js/ && \
    test -f ./demo/gui/static/js/curve-builder.js || (echo "ERROR: curve-builder.js missing" && exit 1) && \
    test -f ./demo/gui/static/js/pricer.js || (echo "ERROR: pricer.js missing" && exit 1) && \
    test -f ./demo/gui/static/js/volcube-builder.js || (echo "ERROR: volcube-builder.js missing" && exit 1) && \
    echo "=== Verifying data files ===" && \
    ls -la ./demo/data/input/ && \
    test -f ./demo/data/input/demo_portfolio.json || (echo "ERROR: demo_portfolio.json missing" && exit 1) && \
    echo "=== Verifying rates data directory ===" && \
    test -d ./demo/data/input/rates || (echo "ERROR: rates directory missing" && exit 1) && \
    ls -la ./demo/data/input/rates/ && \
    test -f ./demo/data/input/rates/usd-sofr.json || (echo "ERROR: usd-sofr.json missing" && exit 1) && \
    echo "=== Verifying irvol data directory ===" && \
    test -d ./demo/data/input/irvol || (echo "ERROR: irvol directory missing" && exit 1) && \
    ls -la ./demo/data/input/irvol/ && \
    test -f ./demo/data/input/irvol/usd-sofr-swaption.json || (echo "ERROR: usd-sofr-swaption.json missing" && exit 1) && \
    echo "=== Verifying fxvol data directory ===" && \
    test -d ./demo/data/input/fxvol || (echo "ERROR: fxvol directory missing" && exit 1) && \
    ls -la ./demo/data/input/fxvol/ && \
    echo "=== Verifying events data directory ===" && \
    test -d ./demo/data/input/events || (echo "ERROR: events directory missing" && exit 1) && \
    ls -la ./demo/data/input/events/ && \
    echo "=== All critical files verified ==="

ENV RUST_LOG=info
ENV FB_OPEN_BROWSER=false

RUN useradd -m appuser
USER appuser

CMD ["./demo-web"]
