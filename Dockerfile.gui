# --- Stage 1: Build Frontend ---
FROM node:20-slim AS frontend-builder

WORKDIR /app/demo/gui/static

COPY demo/gui/static/package*.json ./
RUN npm ci

COPY demo/gui/static/ ./
RUN npm run build

# --- Stage 2: Build Backend ---
FROM rust:1.84-slim-bookworm AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

# Copy built frontend from previous stage
COPY --from=frontend-builder /app/demo/gui/dist ./demo/gui/dist

RUN cargo build --release -p service_gateway --features demo --bin neutryx-server

# --- Stage 3: Runtime ---
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/neutryx-server ./neutryx-server
# Copy Vite build output to the path expected by the code
COPY --from=builder /app/demo/gui/dist ./demo/gui/dist
# Copy data files for nest_service("/data/input", ServeDir::new("demo/data/input"))
COPY --from=builder /app/demo/data/input ./demo/data/input

# Verify critical files exist (build will fail if missing)
# This helps catch file path issues before deployment
RUN echo "=== Verifying Vite build output ===" && \
    ls -la ./demo/gui/dist/ && \
    test -f ./demo/gui/dist/index.html || (echo "ERROR: index.html missing" && exit 1) && \
    echo "=== Verifying assets directory ===" && \
    test -d ./demo/gui/dist/assets || (echo "ERROR: assets directory missing" && exit 1) && \
    ls -la ./demo/gui/dist/assets/ && \
    echo "=== Verifying data files ===" && \
    ls -la ./demo/data/input/ && \
    test -f ./demo/data/input/demo_portfolio.json || (echo "ERROR: demo_portfolio.json missing" && exit 1) && \
    echo "=== Verifying rates data directory ===" && \
    test -d ./demo/data/input/rates || (echo "ERROR: rates directory missing" && exit 1) && \
    ls -la ./demo/data/input/rates/ && \
    test -f ./demo/data/input/rates/usd-sofr.json || (echo "ERROR: usd-sofr.json missing" && exit 1) && \
    echo "=== Verifying irvol data directory ===" && \
    test -d ./demo/data/input/irvol || (echo "ERROR: irvol directory missing" && exit 1) && \
    ls -la ./demo/data/input/irvol/ && \
    test -f ./demo/data/input/irvol/usd-sofr-swaption.json || (echo "ERROR: usd-sofr-swaption.json missing" && exit 1) && \
    echo "=== Verifying fxvol data directory ===" && \
    test -d ./demo/data/input/fxvol || (echo "ERROR: fxvol directory missing" && exit 1) && \
    ls -la ./demo/data/input/fxvol/ && \
    echo "=== Verifying events data directory ===" && \
    test -d ./demo/data/input/events || (echo "ERROR: events directory missing" && exit 1) && \
    ls -la ./demo/data/input/events/ && \
    echo "=== All critical files verified ==="

ENV RUST_LOG=info
ENV FB_OPEN_BROWSER=false

RUN useradd -m appuser
USER appuser

CMD ["./neutryx-server"]
