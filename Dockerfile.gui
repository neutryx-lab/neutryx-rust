# --- Stage 1: Build ---
FROM rust:1.84-slim-bookworm as builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

COPY . .

RUN cargo build --release -p demo_gui --bin demo-web

# --- Stage 2: Runtime ---
FROM debian:bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/demo-web ./demo-web
# Copy static files to the path expected by the code
COPY --from=builder /app/demo/gui/static ./demo/gui/static
# Copy data files inside static directory for reliable serving via fallback_service
# Browser requests to /data/input/* will be served from demo/gui/static/data/input/*
COPY --from=builder /app/demo/data/input ./demo/gui/static/data/input

ENV RUST_LOG=info
ENV FB_OPEN_BROWSER=false

RUN useradd -m appuser
USER appuser

CMD ["./demo-web"]
